# --- Requerido para desarrollo ---
# El cliente en dev apunta por defecto a http://localhost:4000
# (o a VITE_API_URL si se define). Mantener PORT y API_URL en el mismo puerto.
PORT=4000
NODE_ENV=development

# Cadena de conexión a MongoDB (Atlas o local). Sin esto la API arranca
# igual pero sin base de datos.
MONGODB_STRING=

# --- URLs ---
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
API_URL_PROD=https://matayas-api.fly.dev
CLIENT_URL_PROD=https://amplificadoresmatayas.com

# --- CORS ---
# Lista blanca de orígenes permitidos, separados por coma. Obligatorio en
# producción. Si se omite, se usan CLIENT_URL / CLIENT_URL_PROD y los dominios
# conocidos del sitio (amplificadoresmatayas.com) + localhost:5173 en dev.
CORS_ORIGINS=

# Límite de tamaño del body (las imágenes se guardan como base64 en Mongo).
BODY_LIMIT=25mb

# --- Auth / sesiones ---
PRIVATE_SECRET=
DEFAULT_PASSWORD=
DEFAULT_USERNAME=
# Lista de emails con rol admin. Acepta JSON (["a@x.com","b@y.com"]) o coma-separado.
ADMIN_EMAIL_LIST=

# --- SendGrid (email) ---
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
SENDGRID_TEMPLATE_CONTACT_MESSAGE=
SENDGRID_TEMPLATE_MAIL_VERIFICATION=

# --- Google OAuth ---
# Requerido para que la API arranque: las estrategias de passport se
# instancian al importar y lanzan si falta el clientID.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# --- Instagram ---
INSTAGRAM_USER_ID=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
